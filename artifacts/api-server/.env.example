# Copy this file to .env and fill in your values.
# The server reads .env automatically on startup (Node 20.6+).

# ── VNG game API ──────────────────────────────────────────────────────────────
# Your VNG API key (required — the server won't talk to the game without this).
VNG_API_KEY=your-vng-api-key-here

# ── Session ───────────────────────────────────────────────────────────────────
# Any long random string; used to sign session cookies.
SESSION_SECRET=change-me-to-something-random

# ── OpenAI (optional) ─────────────────────────────────────────────────────────
# Only needed for AI-assisted routes (the MCP / LLM planner features).
# Leave blank to run the server without AI features.
# On Replit these are injected automatically; on your local machine set them here.
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1
